# Copy to .env.local for local development. Never commit real values.
# Production values go in Vercel → Project → Settings → Environment Variables.

# Required: your Anthropic API key (from this project's own Claude Console workspace).
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=

# Optional: extra allowed origins for /api/chat, comma-separated (for example a custom domain
# served through another host). The site's own domain is always allowed.
ALLOWED_ORIGINS=

# Optional but recommended: a free FRED API key (fred.stlouisfed.org → My Account → API Keys).
# Without it, the Dollar tracker uses FRED's public CSV download, which works but is less reliable.
FRED_API_KEY=

# Optional: a free EIA API key (eia.gov/opendata) to show U.S. electricity generation on the Dollar tracker.
EIA_API_KEY=
